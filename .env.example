# One block per tenant. The prefix becomes the tenant id passed as "tenant" on tool calls
# (ACME_PROD -> acme-prod). Ids ending in -dev/-qa/-test/-uat/-stg/-staging/-sandbox are treated as development.
ACME_PROD_API_BASE_URL=https://your-app.example.com
ACME_PROD_API_USERNAME=your_username
ACME_PROD_API_PASSWORD=your_password

ACME_DEV_API_BASE_URL=https://your-app-dev.example.com
ACME_DEV_API_USERNAME=your_username
ACME_DEV_API_PASSWORD=your_password

# Druid Generic Chat (agent testing) — copy from the AI Agent's
# Channels -> "Druid Generic Chat" dialog. Optional: the chat tools
# probe derived hosts when these are absent.
CHAT_AUTHORIZE_URL=https://druidapi.druidplatform.com/api/services/app/Chat/AuthorizeAnonymousAsync
CHAT_AGENT_URL=https://druidbotapp-po0.druidplatform.com/api/generic-chat/{botId}/messages
